// Monochrome launcher
configuration {
    modi:                  "drun,filebrowser,window,run";
    show-icons:            true;
    icon-theme:            "breeze-dark";
    display-drun:          "";
    display-run:           "";
    display-filebrowser:   "";
    display-window:        "";
    drun-display-format:   "{name}";
    window-format:         "{w}  {t}";
    font:                  "Noto Sans CJK KR 12";
}

@theme "~/.config/rofi/themes/theme.rasi"

* {
    background-color:      transparent;
    text-color:            @main-fg;
}

window {
    width:                 620px;
    location:              center;
    anchor:                center;
    border:                1px;
    border-radius:         10px;
    border-color:          #ffffff40;
    background-color:      @main-bg;
}

mainbox {
    orientation:           vertical;
    spacing:               12px;
    padding:               16px;
    children:              [ "inputbar", "message", "listview" ];
}

inputbar {
    spacing:               12px;
    padding:               12px 16px;
    border-radius:         8px;
    background-color:      @select-bg;
    children:              [ "prompt", "entry" ];
}

prompt {
    text-color:            @main-ex;
    vertical-align:        0.5;
}

entry {
    placeholder:           "Search";
    placeholder-color:     @main-ex;
    cursor:                text;
    vertical-align:        0.5;
}

listview {
    columns:               1;
    lines:                 8;
    spacing:               2px;
    cycle:                 true;
    dynamic:               true;
    scrollbar:             false;
    fixed-height:          false;
    cursor:                "default";
}

element {
    orientation:           horizontal;
    spacing:               12px;
    padding:               9px 12px;
    border-radius:         8px;
    cursor:                pointer;
}

element normal.urgent,
element alternate.urgent {
    text-color:            @main-fg;
}

element alternate.normal {
    background-color:      transparent;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color:      #ffffff24;
    text-color:            #ffffff;
}

element-icon {
    size:                  1.5em;
    cursor:                inherit;
    vertical-align:        0.5;
}

element-text {
    cursor:                inherit;
    text-color:            inherit;
    vertical-align:        0.5;
}

message {
    padding:               10px 12px;
    border-radius:         8px;
    background-color:      @select-bg;
}

textbox {
    text-color:            @main-fg;
}
