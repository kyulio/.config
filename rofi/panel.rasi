// 우측 상단 rofi 메뉴 (우클릭용 예전 Wi-Fi/블루투스/오디오, 팬·GPU 메뉴) — 패널과 같은 디자인
@import "config.rasi"

configuration {
    show-icons: false;
}

window {
    location: north east;
    anchor:   north east;
    x-offset: -8px;
    y-offset: 38px;
    width:    400px;
}

mainbox {
    children: [ "header", "inputbar", "message", "listview" ];
}

textbox-icon {
    str: "󰒓";
}

listview {
    lines: 9;
}
